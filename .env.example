# Postgres connection string.
#
# Any Postgres works. The quickest is Neon (free, no card, ~2 minutes):
#   1. https://neon.tech  ->  sign up  ->  create a project
#   2. copy the "Connection string" it shows you
#   3. paste it below, in .env.local (NOT this file — .env.local is gitignored)
#
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs nothing by itself — session tokens are random and stored server-side —
# but reserved for cookie signing if that is added later.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
